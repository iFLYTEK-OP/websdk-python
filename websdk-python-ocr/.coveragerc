[run]
# 数据文件位置
data_file = .coverage

# 源代码目录
source = xfyunsdkocr

# 需要测量覆盖率的文件
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */site-packages/*
    setup.py

# 分支覆盖率
branch = True

[report]
# 忽略错误
ignore_errors = False

# 精度
precision = 2

# 显示缺失行
show_missing = True

# 跳过覆盖的文件
skip_covered = False

# 排除的行
exclude_lines =
    # 标准的排除模式
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod
    pass

[html]
# HTML 报告目录
directory = htmlcov

# 标题
title = websdk-python-ocr Coverage Report

[xml]
# XML 报告输出
output = coverage.xml

[paths]
source =
    xfyunsdkocr/
    */xfyunsdkocr/

